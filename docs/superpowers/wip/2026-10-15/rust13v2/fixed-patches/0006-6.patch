diff --git a/tests/http.rs b/tests/http.rs
index 14e32ab..0150f12 100644
--- a/tests/http.rs
+++ b/tests/http.rs
@@ -345,6 +345,18 @@ async fn list_searches_and_paginates() {
     assert_eq!(response.status(), StatusCode::BAD_REQUEST);
 }
 
+#[tokio::test]
+async fn page_after_the_last_says_so() {
+    let app = test_app().await;
+    let cookie = app.sign_up("alice@example.com", PASSWORD).await;
+    app.create_note(&cookie, "メモ", "").await;
+
+    // ノートはあるが、99 ページ目には無い。「まだノートがありません」は出さない
+    let html = body_text(app.get("/notes?page=99", Some(&cookie)).await).await;
+    assert!(html.contains("このページにはノートがありません。"));
+    assert!(!html.contains("まだノートがありません"));
+}
