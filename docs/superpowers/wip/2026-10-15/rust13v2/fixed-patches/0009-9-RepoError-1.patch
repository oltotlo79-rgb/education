+        // 借りて分類しても、渡して変換しても、同じ状態コードになる
+        let make = || {
+            [
+                RepoError::VersionMismatch,
+                RepoError::NotFound,
+                RepoError::UniqueViolation("x".to_string()),
+                RepoError::InvalidData("y".to_string()),
